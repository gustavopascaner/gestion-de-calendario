{
  "name": "booking-page",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Página de reservas personal estilo Calendly: SQLite + Google Calendar + SMTP, un solo proceso Node.",
  "engines": {
    "node": ">=22.13"
