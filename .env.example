# Copiá este archivo a .env y completalo.

PORT=3000
# URL pública (se usa en los links de los emails y en la redirección de OAuth)
BASE_URL=http://localhost:3000

# Secreto para firmar los links de cancelar/reprogramar. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=

# Quién puede embeber /book en un iframe (lista separada por espacios) o * para cualquiera.
EMBED_ORIGINS=*
# Poné 1 si corrés detrás de un proxy inverso (nginx, Caddy, etc.) para el rate-limit por IP.
TRUST_PROXY=0

# Ruta de la base SQLite (opcional)
# DB_PATH=./data/bookings.db

# --- Email (SMTP). Sin SMTP_HOST los mails solo se escriben en la consola. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Gus Pascaner <hola@tudominio.com>"
# Te llega un aviso de cada reserva, cambio y cancelación
OWNER_EMAIL=

# --- Google Calendar (opcional, ver README) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con la URI autorizada en Google Cloud
GOOGLE_REDIRECT_URI=http://localhost:3000/admin/google/callback
GOOGLE_CALENDAR_ID=primary
# Contraseña del panel /admin (configurar evento, horarios y formulario). Sin esto el panel está desactivado.
ADMIN_SECRET=
